[Unit]
Description=NovaBoost SSR and API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/novaboost
ExecStart=/usr/bin/env node /var/www/novaboost/server/server.cjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=4000
EnvironmentFile=-/etc/novaboost/novaboost.env
User=novaboost
Group=www-data

[Install]
WantedBy=multi-user.target
